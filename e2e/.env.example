# ============================================================
# fleet-e2e-cypress — variables de entorno de Cypress
# Copia este archivo a .env y ajusta los valores.
# Cypress solo lee variables con el prefijo CYPRESS_.
# ⚠️ .env está git-ignorado: nunca subas credenciales reales.
# ============================================================

# URL del frontend bajo prueba (Vite dev o build en staging)
CYPRESS_baseUrl=http://localhost:5173

# API del backend. Vacío ⇒ se deriva como <baseUrl>/api (proxy de Vite).
# En staging con API en otra URL: https://staging.fleet.midominio.cu/api
CYPRESS_apiUrl=

# Credenciales del usuario ADMIN de pruebas (backend real)
CYPRESS_usuario=admin@empresa.cu
CYPRESS_password=cambia-esta-clave

# Opcional: usuario SIN permisos para verificar el caso 403
CYPRESS_usuarioSinPermisos=
CYPRESS_passwordSinPermisos=

# true  ⇒ se interceptan SOLO las transiciones de estado del pago Enzona
#          (exigen escaneo humano del QR); véase README §6.
# false ⇒ integración pura contra el backend (solo escenarios seguros).
CYPRESS_mockEstadosPago=true
